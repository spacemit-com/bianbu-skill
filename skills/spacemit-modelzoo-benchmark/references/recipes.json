      ],
      "kind": "vision",
      "adapter": "onnx",
      "official_packages": {
        "spacemit-onnxruntime": "2.0.6"
      }
    },
    "gguf": {
      "match_extensions": [
        ".gguf"
      ],
      "kind": "llm",
      "adapter": "gguf",
      "official_packages": {
        "llama.cpp-tools-spacemit": "0.1.1"
      }
    }
  },
