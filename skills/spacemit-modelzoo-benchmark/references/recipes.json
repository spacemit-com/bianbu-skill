{
  "schema_version": 1,
  "validated_source_commit": "e250c5fe3649241be2675e66dcf328fd5a467f93",
  "defaults": {
    "size_limit_bytes": 5000000000,
    "warmup_runs": 1,
    "measured_runs": 3,
    "alert_threshold_pct": 10.0,
    "reserve_disk_bytes": 2000000000
