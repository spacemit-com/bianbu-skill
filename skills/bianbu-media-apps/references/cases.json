  "cases": [
    {
      "id": "1",
      "module": "",
      "title": "mpv打开关闭",
      "priority": "P0",
      "source_precondition": "",
      "expected": [
        "正常打开应用",
        "能用mpv成功播放视频",
        "能成功关闭应用，视频退出播放"
      ],
      "steps": [
        {
          "id": "1",
          "source_step": "打开mpv应用，验证是否能正常打开",
          "allowed_methods": [
            "desktop-launch"
          ],
          "required_observations": [
            {
              "key": "window_visible",
              "evidence_kinds": [
                [
                  "screenshot",
                  "screen_recording"
                ]
              ]
            }
          ]
        },
        {
          "id": "2",
          "source_step": "选中视频，打开方式选择MPV，验证是否能成功打开",
          "allowed_methods": [
            "open-with"
          ],
          "required_observations": [
            {
              "key": "video_advances",
              "evidence_kinds": [
                [
                  "screenshot",
                  "screen_recording"
                ],
                [
                  "time_series"
                ]
              ]
            }
          ]
        },
        {
          "id": "3",
          "source_step": "关闭mpv，验证是否能成功关闭并退出应用",
          "allowed_methods": [
            "window-close"
          ],
          "required_observations": [
            {
              "key": "window_closed",
              "evidence_kinds": [
                [
                  "screenshot",
                  "screen_recording"
                ],
                [
                  "process_state"
                ]
              ]
            }
          ]
        }
      ]
    },
    {
